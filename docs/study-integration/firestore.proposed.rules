rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          "xrUHsuQ8l2WJtB6gt0Ynp0U5VkJ3"
        ];
    }

    // Separate account from isAdmin() — used only for the /work counseling
    // notes app. Keep in sync with public/shared/firebase.js PFKFKS_WORK_UIDS.
    function isWorkStaff() {
      return request.auth != null
        && (isAdmin() || request.auth.uid in [
          "lM7KQjaEW9fQdme6ZIqvu9jVUgx1"
        ]);
    }

    function isValidPreviewResponse() {
      return request.resource.data.keys().hasOnly([
          "userId",
          "cardId",
          "preAnswer",
          "postAnswer",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.cardId is string
        && request.resource.data.cardId.size() <= 500
        && request.resource.data.preAnswer is string
        && request.resource.data.preAnswer.size() <= 5000
        && request.resource.data.postAnswer is string
        && request.resource.data.postAnswer.size() <= 5000;
    }

    function hasUserPreviewCard(cardId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/previewCards/$(cardId));
    }

    match /{path=**}/activitySessions/{activityId} {
      allow read: if request.auth != null && isAdmin();
    }

    match /{path=**}/todos/{todoId} {
      allow read: if request.auth != null && isAdmin();
    }

    match /{path=**}/dailyGoalRecommendations/{recId} {
      allow read: if request.auth != null && isAdmin();
    }

    match /{path=**}/dailyGoalItems/{itemId} {
      allow read: if request.auth != null && isAdmin();
    }

    match /{path=**}/dailyScheduleRecommendations/{docId} {
      allow read: if request.auth != null && isAdmin();
    }

    match /{path=**}/eventLogs/{eventId} {
      allow read: if request.auth != null && isAdmin();
    }

    match /{path=**}/petites/{petiteId} {
      allow read: if request.auth != null && isAdmin();
    }


    match /users/{userId}/flowlog/data/activitySessions/{activityId} {
      allow read: if owns(userId) || isAdmin();
      allow create: if owns(userId) && validActivity(request.resource.data) && request.resource.data.revision == 1;
      allow update: if owns(userId) && validActivity(request.resource.data)
        && request.resource.data.revision == resource.data.get('revision', 0) + 1;
      allow delete: if false;
    }

    match /users/{userId}/flowlog/data/todos/{todoId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/flowlog/{document=**} {
      allow read: if owns(userId) || isAdmin();
    }
    match /users/{userId}/flowlog/{documentId} {
      allow write: if owns(userId) && (documentId != 'config'
        || !('mainButton' in request.resource.data)
        || request.resource.data.mainButton.buttons.size() <= 10);
    }
    match /users/{userId}/flowlog/{documentId}/{collectionId}/{recordId}/{nested=**} {
      allow write: if owns(userId) && !(documentId == 'data' && collectionId == 'activitySessions');
    }
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function validActivity(d) {
      return d.revision is int && d.revision > 0
        && d.startTime is number && d.endTime is number
        && d.endTime >= d.startTime && d.durationMillis is number
        && d.durationMillis >= 0 && d.durationMillis <= d.endTime - d.startTime
        && d.title is string && d.title.size() <= 500
        && d.category is string && d.category.size() <= 40 && d.modifiedTime is number;
    }
    function validSegment(segments, i, parent) {
      return segments.size() <= i || (segments[i].keys().hasOnly(['startTime', 'endTime'])
        && segments[i].startTime is number && segments[i].endTime is number
        && segments[i].startTime >= parent.startTime && segments[i].endTime <= parent.endTime
        && segments[i].endTime > segments[i].startTime
        && (i == 0 || segments[i].startTime >= segments[i - 1].endTime));
    }
    function validLiveStudyLink(uid, d) {
      let p = getAfter(/databases/$(database)/documents/users/$(uid)/flowlog/data/activitySessions/$(d.activityId)).data;
      return !p.get('isDeleted', false) && p.get('deletedAt', null) == null
          && !(p.category == 'MOVE' && d.phase == 'COURSE_SESSION')
          && d.segments is list && d.segments.size() > 0 && d.segments.size() <= 8
          && validSegment(d.segments,0,p) && validSegment(d.segments,1,p)
          && validSegment(d.segments,2,p) && validSegment(d.segments,3,p)
          && validSegment(d.segments,4,p) && validSegment(d.segments,5,p)
          && validSegment(d.segments,6,p) && validSegment(d.segments,7,p);
    }
    function validStudyLink(uid, d) {
      return d.keys().hasOnly(['schemaVersion','activityId','courseId','lessonId','lessonDate',
          'phase','segments','snapshot','sourceVersion','confirmedAt','updatedAt','revision','deletedAt'])
        && d.schemaVersion == 1 && d.activityId is string && d.activityId.matches('^[^/]{1,300}$')
        && d.courseId is string && d.courseId.size() <= 200
        && d.lessonId is string && d.lessonId.size() <= 300
        && d.lessonDate is string && d.lessonDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.phase in ['COURSE_SESSION','STUDY','REVIEW_1','REVIEW_2','RECORD']
        && d.snapshot is map && d.sourceVersion is string && d.sourceVersion.size() <= 5000
        && d.confirmedAt is number && d.updatedAt is number && d.revision is int
        && (d.deletedAt == null || d.deletedAt is number)
        && (d.deletedAt != null || validLiveStudyLink(uid, d));
    }
    match /users/{userId}/activityStudyLinks/{linkId} {
      allow read: if owns(userId);
      allow create: if owns(userId) && validStudyLink(userId, request.resource.data)
        && request.resource.data.revision == 1;
      allow update: if owns(userId) && validStudyLink(userId, request.resource.data)
        && request.resource.data.activityId == resource.data.activityId
        && request.resource.data.lessonId == resource.data.lessonId
        && request.resource.data.phase == resource.data.phase
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owns(userId);
    }
    match /users/{userId}/interactionDecisions/{decisionId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly(['schemaVersion','decisionId','proposalId','kind',
          'activityId','category','localDate','minuteOfDay','weekday','outcome','createdAt','revision','payload'])
        && request.resource.data.schemaVersion == 1 && request.resource.data.decisionId == decisionId
        && request.resource.data.proposalId is string
        && request.resource.data.kind in ['CLASSIFICATION_CONFIRM','STUDY_LINK_CONFIRM','STUDY_LINK_REMOVE',
          'BUTTON_USE','BUTTON_ADD','BUTTON_REPLACE','RECOMMENDATION_SHOWN','RECOMMENDATION_DISMISS',
          'RECOMMENDATION_SNOOZE','RECOMMENDATION_DISABLE','UNDO']
        && request.resource.data.outcome in ['APPLIED','DECLINED','SNOOZED','SHOWN']
        && request.resource.data.localDate is string
        && request.resource.data.minuteOfDay is int && request.resource.data.minuteOfDay >= 0
        && request.resource.data.minuteOfDay < 1440
        && request.resource.data.weekday is int && request.resource.data.weekday >= 0 && request.resource.data.weekday <= 6
        && request.resource.data.createdAt is number && request.resource.data.revision == 1
        && request.resource.data.payload is map;
      allow update: if owns(userId) && request.resource.data == resource.data;
    }


    match /users/{userId}/previewUsage/{docId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /users/{userId}/previewCards/{cardId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Personal university course and review tracker. No cross-account access.
    match /users/{userId}/studyCourses/{courseId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'start', 'end', 'days', 'time', 'endTime', 'color'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.start is string && request.resource.data.end is string
        && request.resource.data.days is list && request.resource.data.days.size() > 0
        && request.resource.data.days.size() <= 7
        && request.resource.data.days.hasOnly([0, 1, 2, 3, 4, 5, 6])
        && request.resource.data.time is string && request.resource.data.endTime is string
        && request.resource.data.color is string;
    }
    match /users/{userId}/studyRecords/{lessonId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['done', 'note', 'skipped'])
        && request.resource.data.done is list && request.resource.data.done.size() == 3
        && request.resource.data.done[0] is string && request.resource.data.done[1] is string
        && request.resource.data.done[2] is string
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.skipped is bool;
    }

    match /posts/{postId} {
      allow get, list: if resource.data.status == "published" || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status in ["draft", "published"];
      allow update: if isAdmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status in ["draft", "published"];
      allow delete: if isAdmin();
    }

    match /series/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /flowlogSurveyResponses/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /previewCards/{cardId} {
      allow get, list: if resource.data.status == "published" || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.status in ["draft", "reviewed", "published", "archived"];
      allow update: if isAdmin()
        && request.resource.data.status in ["draft", "reviewed", "published", "archived"];
      allow delete: if isAdmin();
    }

    match /previewResponses/{responseId} {
      allow create: if request.auth != null
        && isValidPreviewResponse()
        && hasUserPreviewCard(request.resource.data.cardId)
        && responseId == request.auth.uid + "_" + request.resource.data.cardId;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.cardId == resource.data.cardId
        && isValidPreviewResponse()
        && hasUserPreviewCard(resource.data.cardId)
        && responseId == request.auth.uid + "_" + resource.data.cardId;
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /previewRevisionLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /todoAdminMeta/{todoId} {
      allow read, write: if isAdmin();
    }

    match /userDistCaches/{uid} {
      allow read: if request.auth != null && isAdmin();
    }

    match /adminStats/{docId} {
      allow read: if request.auth != null && isAdmin();
    }

    match /students/{studentId} {
      allow read, write: if isWorkStaff();
    }

    match /counselingSessions/{sessionId} {
      allow read, write: if isWorkStaff();
    }

    match /counselingReservations/{reservationId} {
      allow read, write: if isWorkStaff();
    }

    match /attendanceUploads/{docId} {
      allow read, write: if isWorkStaff();
    }

    match /students/{studentId}/attendanceRecords/{dateId} {
      allow read, write: if isWorkStaff();
    }

    match /students/{studentId}/counselingRecords/{recordId} {
      allow read, write: if isWorkStaff();
    }

    match /dailyNotes/{dateId} {
      allow read, write: if isWorkStaff();
    }

    // /fm24 — Football Manager 선수 추적기.
    // 내 PC의 로컬 앱(SQLite)이 진실이고, 여기에는 화면용 사본만 올라온다.
    // 읽기/쓰기 모두 관리자 본인만 (public/fm24/firebase-config.js 의
    // ALLOWED_UIDS 와 맞춰야 함 — 한쪽만 바꾸면 깨진다).
    match /fm24/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}

